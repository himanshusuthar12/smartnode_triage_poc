# OPENAI & HUGGING FACE CONFIGURATION
OPENAI_API_KEY=""
HF_TOKEN=""

# OpenAI model
OPENAI_MODEL=gpt-4o-mini

# Faster-Whisper model (Options can include: tiny, base, small, medium, large-v3)
WHISPER_MODEL=small

# CPU configuration
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Hugging Face speaker diarization model
HF_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1